<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ufit.fx.FxController"
      styleClass="root-container" spacing="0">

    <!-- ═══════════════ HEADER ═══════════════ -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
        <padding><Insets top="14" right="28" bottom="14" left="28"/></padding>
        <Label text="UFit" styleClass="logo-label"/>
        <Label text="|" styleClass="header-divider"/>
        <Label text="Health &amp; Fitness Calculators" styleClass="title-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="v2.0 — Spring Boot + JavaFX" styleClass="subtitle-label"/>
    </HBox>

    <!-- ═══════════════ TAB PANE ═══════════════ -->
    <TabPane styleClass="calc-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ══════ TAB 1 — BMI ══════ -->
        <Tab text="  BMI  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="BMI Calculator" styleClass="calc-page-title"/>
                        <Label text="Body Mass Index — a screening measure of body fat based on weight and height" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Enter Your Information" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="12">
                                <Label text="Weight (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bmiWeightField" promptText="e.g. 75" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Height (m)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bmiHeightField" promptText="e.g. 1.75" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Calculate" onAction="#onCalculateBmi" styleClass="btn-primary" prefWidth="130" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearBmi" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <!-- Big result header -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="BMI:" styleClass="result-hero-label"/>
                                <Label fx:id="bmiResultLabel" text="—" styleClass="result-hero-value"/>
                                <Label fx:id="bmiCategoryLabel" text="" styleClass="result-hero-category"/>
                            </HBox>

                            <!-- Gauge -->
                            <StackPane fx:id="bmiChartPane" minHeight="90" maxHeight="90"/>

                            <!-- Details Table -->
                            <VBox fx:id="bmiDetailsBox" styleClass="details-table" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="info-box" spacing="6">
                        <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                        <Label text="&#x2139;  About BMI" styleClass="info-title"/>
                        <Label wrapText="true" styleClass="info-text" text="Body Mass Index (BMI) is calculated by dividing weight (kg) by height² (m²). It is a widely used screening tool for weight categories. BMI Categories: Underweight &lt; 18.5 | Normal 18.5–24.9 | Overweight 25.0–29.9 | Obese ≥ 30.0"/>
                        <Label wrapText="true" styleClass="info-detail" text="Note: BMI does not distinguish between muscle and fat, so it may not be accurate for athletes or very muscular individuals."/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════ TAB 2 — BMR ══════ -->
        <Tab text="  BMR  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="BMR Calculator" styleClass="calc-page-title"/>
                        <Label text="Basal Metabolic Rate — calories your body burns at complete rest" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Enter Your Information" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="12">
                                <Label text="Weight (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bmrWeightField" promptText="e.g. 75" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Height (m)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bmrHeightField" promptText="e.g. 1.75" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Age" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bmrAgeField" promptText="e.g. 25" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Gender" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="bmrGenderBox" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Calculate" onAction="#onCalculateBmr" styleClass="btn-primary" prefWidth="130" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearBmr" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER" spacing="24">
                                <VBox styleClass="result-card" alignment="CENTER" minWidth="150">
                                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                                    <Label text="Mifflin-St Jeor" styleClass="result-title"/>
                                    <Label fx:id="bmrMifflinLabel" text="—" styleClass="result-value"/>
                                    <Label text="cal/day" styleClass="result-unit"/>
                                </VBox>
                                <VBox styleClass="result-card" alignment="CENTER" minWidth="150">
                                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                                    <Label text="Harris-Benedict" styleClass="result-title"/>
                                    <Label fx:id="bmrHarrisLabel" text="—" styleClass="result-value"/>
                                    <Label text="cal/day" styleClass="result-unit"/>
                                </VBox>
                            </HBox>

                            <StackPane fx:id="bmrChartPane" minHeight="220" VBox.vgrow="SOMETIMES"/>
                            <VBox fx:id="bmrDetailsBox" styleClass="details-table" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="info-box" spacing="6">
                        <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                        <Label text="&#x2139;  About BMR" styleClass="info-title"/>
                        <Label wrapText="true" styleClass="info-text" text="BMR is the calories your body needs at rest for basic functions (breathing, circulation, cell production). It accounts for 60–75% of daily calorie expenditure. Two formulas are compared: Mifflin-St Jeor (recommended) and Harris-Benedict (revised 1984)."/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════ TAB 3 — BODY FAT ══════ -->
        <Tab text="  Body Fat  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="Body Fat Calculator" styleClass="calc-page-title"/>
                        <Label text="Estimate your body fat percentage using the U.S. Navy circumference method" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Enter Your Measurements" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="12">
                                <Label text="Weight (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bfWeightField" promptText="e.g. 80" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Waist (cm)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bfWaistField" promptText="e.g. 85" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Neck (cm)" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bfNeckField" promptText="e.g. 38" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Height (cm)" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="bfHeightField" promptText="e.g. 175" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Gender" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="bfGenderBox" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Calculate" onAction="#onCalculateBf" styleClass="btn-primary" prefWidth="130" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearBf" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Body Fat:" styleClass="result-hero-label"/>
                                <Label fx:id="bfResultLabel" text="—" styleClass="result-hero-value"/>
                                <Label fx:id="bfCategoryLabel" text="" styleClass="result-hero-category"/>
                            </HBox>

                            <StackPane fx:id="bfChartPane" minHeight="90" maxHeight="90"/>
                            <VBox fx:id="bfDetailsBox" styleClass="details-table" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="info-box" spacing="6">
                        <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                        <Label text="&#x2139;  About Body Fat %" styleClass="info-title"/>
                        <Label wrapText="true" styleClass="info-text" text="Body fat % is the proportion of total weight that is fat tissue. The U.S. Navy method estimates it from waist, neck, and height. Male: Essential &lt;6% | Athletic 6–13% | Fitness 14–17% | Average 18–24% | Above Average 25%+. Female: Essential &lt;14% | Athletic 14–20% | Fitness 21–24% | Average 25–31% | Above Average 32%+"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════ TAB 4 — TDEE ══════ -->
        <Tab text="  TDEE  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="TDEE Calculator" styleClass="calc-page-title"/>
                        <Label text="Total Daily Energy Expenditure — total daily calorie burn including activity" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Enter Your Information" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="12">
                                <Label text="Weight (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="tdeeWeightField" promptText="e.g. 75" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Height (m)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="tdeeHeightField" promptText="e.g. 1.75" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Age" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="tdeeAgeField" promptText="e.g. 25" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Gender" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="tdeeGenderBox" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <Label text="Activity" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="tdeeActivityBox" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Calculate" onAction="#onCalculateTdee" styleClass="btn-primary" prefWidth="130" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearTdee" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>

                            <HBox alignment="CENTER" spacing="20">
                                <VBox styleClass="result-card-highlight" alignment="CENTER" minWidth="160">
                                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                                    <Label text="TDEE" styleClass="result-title"/>
                                    <Label fx:id="tdeeResultLabel" text="—" styleClass="result-value-accent"/>
                                    <Label text="cal/day" styleClass="result-unit"/>
                                </VBox>
                                <VBox styleClass="result-card" alignment="CENTER" minWidth="140">
                                    <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
                                    <Label text="BMR" styleClass="result-title"/>
                                    <Label fx:id="tdeeBmrLabel" text="—" styleClass="result-value"/>
                                    <Label text="cal/day" styleClass="result-unit"/>
                                </VBox>
                            </HBox>

                            <StackPane fx:id="tdeeChartPane" minHeight="250" VBox.vgrow="SOMETIMES"/>
                            <VBox fx:id="tdeeDetailsBox" styleClass="details-table" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="info-box" spacing="6">
                        <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                        <Label text="&#x2139;  About TDEE" styleClass="info-title"/>
                        <Label wrapText="true" styleClass="info-text" text="TDEE = BMR × activity multiplier. Sedentary ×1.2 | Light ×1.375 | Moderate ×1.55 | Active ×1.725 | Extra Active ×1.9. To lose ~0.5kg/week, eat ~500 cal below TDEE. To gain, eat ~500 cal above."/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════ TAB 5 — IDEAL WEIGHT ══════ -->
        <Tab text="  Ideal Weight  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="Ideal Weight Calculator" styleClass="calc-page-title"/>
                        <Label text="Compare estimates from four well-known medical formulas" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Enter Your Information" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="12">
                                <Label text="Height (cm)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="iwHeightField" promptText="e.g. 175" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Gender" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="iwGenderBox" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Calculate" onAction="#onCalculateIw" styleClass="btn-primary" prefWidth="130" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearIw" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Formula Results" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="10" alignment="CENTER">
                                <VBox styleClass="result-card" alignment="CENTER" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                    <Label text="Devine" styleClass="result-title"/>
                                    <Label fx:id="iwDevineLabel" text="—" styleClass="result-value-sm"/>
                                    <Label text="kg" styleClass="result-unit"/>
                                </VBox>
                                <VBox styleClass="result-card" alignment="CENTER" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                    <Label text="Robinson" styleClass="result-title"/>
                                    <Label fx:id="iwRobinsonLabel" text="—" styleClass="result-value-sm"/>
                                    <Label text="kg" styleClass="result-unit"/>
                                </VBox>
                                <VBox styleClass="result-card" alignment="CENTER" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                    <Label text="Miller" styleClass="result-title"/>
                                    <Label fx:id="iwMillerLabel" text="—" styleClass="result-value-sm"/>
                                    <Label text="kg" styleClass="result-unit"/>
                                </VBox>
                                <VBox styleClass="result-card" alignment="CENTER" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                                    <Label text="Hamwi" styleClass="result-title"/>
                                    <Label fx:id="iwHamwiLabel" text="—" styleClass="result-value-sm"/>
                                    <Label text="kg" styleClass="result-unit"/>
                                </VBox>
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>
                            </GridPane>
                            <StackPane fx:id="iwChartPane" minHeight="240" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="info-box" spacing="6">
                        <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>
                        <Label text="&#x2139;  About Ideal Weight" styleClass="info-title"/>
                        <Label wrapText="true" styleClass="info-text" text="Four medical formulas are compared: Devine (1974), Robinson (1983), Miller (1983), and Hamwi (1964). These are estimates — body composition, bone density, and muscle mass differ per individual."/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ══════ TAB 6 — HISTORY ══════ -->
        <Tab text="  History  ">
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="tab-scroll">
                <VBox spacing="18" styleClass="tab-content">
                    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

                    <VBox styleClass="calc-header-box" spacing="2">
                        <Label text="Full Health Report &amp; History" styleClass="calc-page-title"/>
                        <Label text="Run a complete calculation and track progress over time" styleClass="calc-page-subtitle" wrapText="true"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="330">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Complete Information" styleClass="section-title"/>
                            <Separator/>
                            <GridPane hgap="12" vgap="10">
                                <Label text="Weight (kg)" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="fullWeightField" promptText="e.g. 75" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Height (m)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="fullHeightField" promptText="e.g. 1.75" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Age" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="fullAgeField" promptText="e.g. 25" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Gender" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="fullGenderBox" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <Label text="Waist (cm)" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="fullWaistField" promptText="e.g. 85" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Neck (cm)" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
                                <TextField fx:id="fullNeckField" promptText="e.g. 38" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="input-field"/>
                                <Label text="Activity" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-label"/>
                                <ComboBox fx:id="fullActivityBox" GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="input-combo"/>
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90" halignment="RIGHT"/>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="140"/>
                                </columnConstraints>
                            </GridPane>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Save &amp; Calculate" onAction="#onCalculateFull" styleClass="btn-primary" prefWidth="150" prefHeight="38"/>
                                <Button text="Clear" onAction="#onClearFull" styleClass="btn-secondary" prefWidth="90" prefHeight="38"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                            <padding><Insets top="20" right="22" bottom="20" left="22"/></padding>
                            <Label text="Progress Trends" styleClass="section-title"/>
                            <Separator/>
                            <StackPane fx:id="historyChartPane" minHeight="280" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="8">
                        <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                        <Label text="Calculation History" styleClass="section-title"/>
                        <TableView fx:id="historyTable" prefHeight="200" VBox.vgrow="ALWAYS" styleClass="history-table">
                            <columns>
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
                                <TableColumn fx:id="hBmiColumn" text="BMI" prefWidth="80"/>
                                <TableColumn fx:id="hBmrColumn" text="BMR (cal)" prefWidth="95"/>
                                <TableColumn fx:id="hBodyFatColumn" text="Body Fat %" prefWidth="95"/>
                                <TableColumn fx:id="hTdeeColumn" text="TDEE (cal)" prefWidth="95"/>
                                <TableColumn fx:id="hIdealWeightColumn" text="Ideal Wt (kg)" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No history yet — fill in all fields and click Save &amp; Calculate!" styleClass="placeholder-label"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>
</VBox>
